map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen ${NGINX_LISTEN_PORT} default_server;
  server_name _;
  location = /health {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "healthy\n";
  }
  location / {
    return 404;
  }
}

server {
  listen ${NGINX_LISTEN_PORT};
  server_name admin.${ROOT_DOMAIN};

  location = /health {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "healthy\n";
  }

  location ^~ /api/admin/ {
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location = /api/admin {
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location ^~ /api/ { return 404; }

  location / {
    proxy_pass http://sms-admin;
    include /etc/nginx/proxy_params;
  }
}

server {
  listen ${NGINX_LISTEN_PORT};
  server_name *.${ROOT_DOMAIN};
  client_max_body_size 20m;

  location = /health {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "healthy\n";
  }

  location = /admin {
    return 301 /admin/;
  }

  location ^~ /admin/ {
    proxy_pass http://sms-school/;
    include /etc/nginx/proxy_params;
  }

  location = /api {
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location = /api/health {
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location ^~ /api/student/ {
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location ^~ /api/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location = /manifest.json {
    proxy_pass http://sms-api:5000/api/student/manifest;
    include /etc/nginx/proxy_params;
  }

  location / {
    proxy_pass http://sms-student:8080;
    include /etc/nginx/proxy_params;
  }
}