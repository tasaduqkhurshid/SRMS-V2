map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen ${NGINX_LISTEN_PORT};
  server_name admin.${ROOT_DOMAIN};

  location = /health {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "healthy\n";
  }

  location ^~ /api/ {
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location / {
    proxy_pass http://sms-admin;
    include /etc/nginx/proxy_params;
  }
}

server {
  listen ${NGINX_LISTEN_PORT} default_server;
  server_name _ *.${ROOT_DOMAIN};
  client_max_body_size 20m;

  location = /health {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "healthy\n";
  }

  location = /admin {
    return 301 /admin/;
  }

  location ^~ /admin/ {
    proxy_pass http://sms-school/;
    include /etc/nginx/proxy_params;
  }

  # Explicit /api routes that Express mounts at /api/... level
  location = /api {
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location = /api/health {
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location ^~ /api/student/ {
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  # mountAdminApi("") routes - explicitly listed to avoid over-broad rewrite
  # These are mounted at ROOT level in Express (no /api prefix)
  location ^~ /api/auth/ {
    rewrite ^/api/auth(/.*)$ /auth$1 break;
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location ^~ /api/options/ {
    rewrite ^/api/options(/.*)$ /options$1 break;
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location ^~ /api/students/ {
    rewrite ^/api/students(/.*)$ /students$1 break;
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location ^~ /api/subjects/ {
    rewrite ^/api/subjects(/.*)$ /subjects$1 break;
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location ^~ /api/courses/ {
    rewrite ^/api/courses(/.*)$ /courses$1 break;
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location ^~ /api/exams/ {
    rewrite ^/api/exams(/.*)$ /exams$1 break;
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location ^~ /api/academic-years/ {
    rewrite ^/api/academic-years(/.*)$ /academic-years$1 break;
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location ^~ /api/results/ {
    rewrite ^/api/results(/.*)$ /results$1 break;
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location ^~ /api/marksheet-templates/ {
    rewrite ^/api/marksheet-templates(/.*)$ /marksheet-templates$1 break;
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location ^~ /api/school/ {
    rewrite ^/api/school(/.*)$ /school$1 break;
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  # Fallback for any other /api/ paths - proxy to API (Express notFoundHandler will handle 404)
  location ^~ /api/ {
    proxy_pass http://sms-api:5000;
    include /etc/nginx/proxy_params;
  }

  location = /manifest.json {
    proxy_pass http://sms-api:5000/api/student/manifest;
    include /etc/nginx/proxy_params;
  }

  location / {
    proxy_pass http://sms-student:8080;
    include /etc/nginx/proxy_params;
  }
}