# Nginx upstreams use Compose service names and container ports.
NGINX_SCHOOL_UPSTREAM=sms-school:80
NGINX_STUDENT_UPSTREAM=sms-student:8080
NGINX_ADMIN_UPSTREAM=sms-admin:80
NGINX_API_UPSTREAM=sms-api:5000
# Production school frontend is built at /; remove /admin before proxying.
NGINX_SCHOOL_STRIP_PREFIX=true
