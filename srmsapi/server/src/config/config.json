{
  "development": {
    "mongodb": {
      "uri": "mongodb://localhost:27017/srms",
      "options": {
        "useNewUrlParser": true,
        "useUnifiedTopology": true
      }
    }
  },
  "production": {
    "mongodb": {
      "uri": "mongodb+srv://username:password@cluster.mongodb.net/srms",
      "options": {
        "useNewUrlParser": true,
        "useUnifiedTopology": true
      }
    }
  }
}