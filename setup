#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

usage() {
  cat <<'EOF'
SRMS unified multi-portal stack

Usage: ./setup [up|down|restart|status|logs|config]

  up       Build and start all services; wait for health checks (default)
  down     Stop containers, keep database volumes
  restart  Rebuild and restart all services
  status   Show service health
  logs     Follow all service logs
  config   Validate the merged Docker Compose configuration
  services Print the active Docker Compose service names
EOF
}

command="${1:-up}"
case "$command" in
  up)
    docker compose up --build -d --wait --remove-orphans
    docker compose ps
    ;;
  down)
    docker compose down
    ;;
  restart)
    docker compose up --build -d --force-recreate --wait --remove-orphans
    docker compose ps
    ;;
  status)
    docker compose ps
    ;;
  logs)
    docker compose logs -f --tail=200
    ;;
  services)
    docker compose config --services
    ;;
  config)
    docker compose config --quiet
    echo "Compose configuration is valid."
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
