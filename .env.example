# =============================================================================
# SRMS V2 - ENVIRONMENT CONFIGURATION
# Copy the ENTIRE block for your chosen profile to .env
# =============================================================================

# -----------------------------------------------------------------------------
# PROFILE: LOCAL (development, uses host MongoDB)
# Run with: ./start-all.sh -e local up
# Or set ENVIRONMENT=local in .env and run: ./start-all.sh up
# -----------------------------------------------------------------------------
# ROOT_DOMAIN=sms.local
# HTTP_PORT=80
# NODE_ENV=development
# LOG_LEVEL=debug
# MONGO_DEBUG=false
# 
# ENVIRONMENT=local
# 
# DB_TYPE=local
# DB_HOST=
# DB_PORT=27017
# DB_NAME=school-system
# DB_USERNAME=srms_admin
# DB_PASSWORD=password
# DB_AUTH_SOURCE=school-system
# DB_REPLICA_SET=
# 
# JWT_SECRET=replace-with-a-long-random-secret
# SEED_DEMO_DATA=true
# HANFIA_ADMIN_PASSWORD=hanfia-admin-local-only
# DEMO_STUDENT_PASSWORD=student-local-only
# SCHOOLB_ADMIN_PASSWORD=schoolb-admin-local-only
# SCHOOLB_STUDENT_PASSWORD=schoolb-student-local-only
# SUPER_ADMIN_PASSWORD=platform-admin-local-only
# 
# R2_ENABLED=true
# R2_ACCOUNT_ID=673ca3f6d63a11b6028e095cd9f8407b
# R2_ACCESS_KEY_ID=0b9c0b6c0f89cc9fe7becaf1af4d43f0
# R2_SECRET_ACCESS_KEY=dcb3244294539bfe012b2f87a4a2ba8cb53f7c22d2af18f71905f7daa444f64f
# R2_PRIVATE_BUCKET_NAME=srms-v2
# R2_PUBLIC_BUCKET_NAME=srms-public-storage
# R2_ENDPOINT=https://673ca3f6d63a11b6028e095cd9f8407b.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://pub-ae891f6766df400ab8d521c44c70f979.r2.dev
# PAYMENT_CREDENTIALS_ENCRYPTION_KEY=6LvXOviXmnSXb+IWxSFTODrPiAQNbKjz1BYkhjmvu1E=
# 
# DEFAULT_TENANT_SLUG=hanfia
# 
# NGINX_SCHOOL_UPSTREAM=sms-school-local:5173
# NGINX_STUDENT_UPSTREAM=sms-student-local:8080
# NGINX_ADMIN_UPSTREAM=sms-admin-local:5173
# NGINX_API_UPSTREAM=sms-api-local:5000
# NGINX_SCHOOL_STRIP_PREFIX=false

# -----------------------------------------------------------------------------
# PROFILE: DOCKER (production-style, uses containerized MongoDB)
# Run with: ./start-all.sh -e docker up
# Or set ENVIRONMENT=docker in .env and run: ./start-all.sh up
# -----------------------------------------------------------------------------
# ROOT_DOMAIN=sms.local
# HTTP_PORT=80
# NODE_ENV=production
# LOG_LEVEL=info
# MONGO_DEBUG=false
# 
# ENVIRONMENT=docker
# 
# DB_TYPE=docker
# DB_HOST=
# DB_PORT=27017
# DB_NAME=school-system
# DB_USERNAME=srms_admin
# DB_PASSWORD=password
# DB_AUTH_SOURCE=admin
# DB_REPLICA_SET=rs0
# 
# JWT_SECRET=replace-with-a-long-random-secret
# SEED_DEMO_DATA=true
# HANFIA_ADMIN_PASSWORD=hanfia-admin-local-only
# DEMO_STUDENT_PASSWORD=student-local-only
# SCHOOLB_ADMIN_PASSWORD=schoolb-admin-local-only
# SCHOOLB_STUDENT_PASSWORD=schoolb-student-local-only
# SUPER_ADMIN_PASSWORD=platform-admin-local-only
# 
# R2_ENABLED=false
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PRIVATE_BUCKET_NAME=srms-v2
# R2_PUBLIC_BUCKET_NAME=srms-public-storage
# R2_ENDPOINT=
# R2_PUBLIC_BASE_URL=
# PAYMENT_CREDENTIALS_ENCRYPTION_KEY=
# 
# DEFAULT_TENANT_SLUG=
# 
# NGINX_SCHOOL_UPSTREAM=sms-school:80
# NGINX_STUDENT_UPSTREAM=sms-student:8080
# NGINX_ADMIN_UPSTREAM=sms-admin:80
# NGINX_API_UPSTREAM=sms-api:5000
# NGINX_SCHOOL_STRIP_PREFIX=true

# -----------------------------------------------------------------------------
# PROFILE: PRODUCTION (production deployment, uses .env.production)
# Run with: ./start-all.sh -e production up
# Or set ENVIRONMENT=production in .env and run: ./start-all.sh up
# -----------------------------------------------------------------------------
# ROOT_DOMAIN=your-production-domain.com
# HTTP_PORT=80
# NODE_ENV=production
# LOG_LEVEL=warn
# MONGO_DEBUG=false
# 
# ENVIRONMENT=production
# 
# DB_TYPE=docker
# DB_HOST=
# DB_PORT=27017
# DB_NAME=school-system
# DB_USERNAME=srms_admin
# DB_PASSWORD=CHANGE_THIS_PASSWORD
# DB_AUTH_SOURCE=admin
# DB_REPLICA_SET=rs0
# 
# JWT_SECRET=GENERATE_A_SECURE_RANDOM_SECRET
# SEED_DEMO_DATA=false
# HANFIA_ADMIN_PASSWORD=SET_SECURE_PASSWORD
# DEMO_STUDENT_PASSWORD=SET_SECURE_PASSWORD
# SCHOOLB_ADMIN_PASSWORD=SET_SECURE_PASSWORD
# SCHOOLB_STUDENT_PASSWORD=SET_SECURE_PASSWORD
# SUPER_ADMIN_PASSWORD=SET_SECURE_PASSWORD
# 
# R2_ENABLED=true
# R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
# R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY
# R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_KEY
# R2_PRIVATE_BUCKET_NAME=srms-v2
# R2_PUBLIC_BUCKET_NAME=srms-public-storage
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://YOUR_PUBLIC_BUCKET.r2.dev
# PAYMENT_CREDENTIALS_ENCRYPTION_KEY=GENERATE_SECURE_KEY
# 
# DEFAULT_TENANT_SLUG=
# 
# NGINX_SCHOOL_UPSTREAM=sms-school:80
# NGINX_STUDENT_UPSTREAM=sms-student:8080
# NGINX_ADMIN_UPSTREAM=sms-admin:80
# NGINX_API_UPSTREAM=sms-api:5000
# NGINX_SCHOOL_STRIP_PREFIX=true