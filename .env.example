# Local school hostname suffix; set to your production root domain when deploying.
ROOT_DOMAIN=sms.local
HTTP_PORT=80

# Development-only defaults. Change both before deployment.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=password
JWT_SECRET=replace-with-a-long-random-secret
SEED_DEMO_DATA=true
HANFIA_ADMIN_PASSWORD=hanfia-admin-local-only
DEMO_STUDENT_PASSWORD=student-local-only
SCHOOLB_ADMIN_PASSWORD=schoolb-admin-local-only
SCHOOLB_STUDENT_PASSWORD=schoolb-student-local-only
SUPER_ADMIN_PASSWORD=platform-admin-local-only
