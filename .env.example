# =============================================================================
# SRMS V2 - ENVIRONMENT CONFIGURATION
# Copy the ENTIRE block for your chosen profile to .env
# =============================================================================

# -----------------------------------------------------------------------------
# PROFILE: LOCAL (development, uses host MongoDB)
# Run with: ./start-all.sh -e local up
# Or set ENVIRONMENT=local in .env and run: ./start-all.sh up
# -----------------------------------------------------------------------------
# ROOT_DOMAIN=sms.local
# HTTP_PORT=80
# NODE_ENV=development
# LOG_LEVEL=debug
# MONGO_DEBUG=false
# PORT=5000
# HOST=0.0.0.0
# TRUST_PROXY=1
# REDIS_URL=redis://redis:6379
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_HOST_PORT=6380
# REDIS_DB=0
# DEBUG_ERRORS=false
# SUPER_ADMIN_EMAIL=platform-admin@sms.local
# DEFAULT_TIMEZONE=Asia/Kolkata
#
# ENVIRONMENT=local
#
# DB_TYPE=local
# DB_HOST=
# DB_PORT=27017
# MONGO_HOST_PORT=27018
# DB_NAME=school-system
# DB_USERNAME=srms_admin
# DB_PASSWORD=GENERATE_A_UNIQUE_LOCAL_DATABASE_PASSWORD
# DB_AUTH_SOURCE=school-system
# DB_REPLICA_SET=
# DB_DIRECT_CONNECTION=false
#
# JWT_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# SEED_DEMO_DATA=false
# HANFIA_ADMIN_PASSWORD=SET_LOCAL_HANFIA_ADMIN_PASSWORD
# DEMO_STUDENT_PASSWORD=SET_LOCAL_DEMO_STUDENT_PASSWORD
# SCHOOLB_ADMIN_PASSWORD=SET_LOCAL_SCHOOLB_ADMIN_PASSWORD
# SCHOOLB_STUDENT_PASSWORD=SET_LOCAL_SCHOOLB_STUDENT_PASSWORD
# HIT_ADMIN_PASSWORD=SET_LOCAL_HIT_ADMIN_PASSWORD
# HIT_ADMIN_PIN=SET_LOCAL_HIT_ADMIN_PIN
# SUPER_ADMIN_PASSWORD=SET_LOCAL_SUPER_ADMIN_PASSWORD
#
# R2_ENABLED=false
# R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
# R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
# R2_PRIVATE_BUCKET_NAME=srms-v2
# R2_PUBLIC_BUCKET_NAME=srms-public-storage
# R2_ENDPOINT=https://YOUR_R2_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://YOUR_PUBLIC_BUCKET_URL
# PAYMENT_CREDENTIALS_ENCRYPTION_KEY=GENERATE_A_RANDOM_32_BYTE_KEY
#
# DEFAULT_TENANT_SLUG=hanfia
#
# NGINX_SCHOOL_UPSTREAM=sms-school-local:5173
# NGINX_STUDENT_UPSTREAM=sms-student-local:8080
# NGINX_ADMIN_UPSTREAM=sms-admin-local:5173
# NGINX_API_UPSTREAM=sms-api-local:5000
# NGINX_SCHOOL_STRIP_PREFIX=false

# -----------------------------------------------------------------------------
# PROFILE: DOCKER (production-style, uses containerized MongoDB)
# Run with: ./start-all.sh -e docker up
# Or set ENVIRONMENT=docker in .env and run: ./start-all.sh up
# -----------------------------------------------------------------------------
# ROOT_DOMAIN=sms.local
# HTTP_PORT=80
# NODE_ENV=production
# LOG_LEVEL=info
# MONGO_DEBUG=false
# PORT=5000
# HOST=0.0.0.0
# TRUST_PROXY=1
# REDIS_URL=redis://redis:6379
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_HOST_PORT=6380
# REDIS_DB=0
# DEBUG_ERRORS=false
# SUPER_ADMIN_EMAIL=platform-admin@sms.local
# DEFAULT_TIMEZONE=Asia/Kolkata
#
# ENVIRONMENT=docker
#
# DB_TYPE=docker
# DB_HOST=
# DB_PORT=27017
# MONGO_HOST_PORT=27018
# DB_NAME=school-system
# DB_USERNAME=srms_admin
# DB_PASSWORD=GENERATE_A_UNIQUE_LOCAL_DATABASE_PASSWORD
# DB_AUTH_SOURCE=admin
# DB_REPLICA_SET=rs0
# DB_DIRECT_CONNECTION=false
#
# JWT_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# SEED_DEMO_DATA=false
# HANFIA_ADMIN_PASSWORD=SET_LOCAL_HANFIA_ADMIN_PASSWORD
# DEMO_STUDENT_PASSWORD=SET_LOCAL_DEMO_STUDENT_PASSWORD
# SCHOOLB_ADMIN_PASSWORD=SET_LOCAL_SCHOOLB_ADMIN_PASSWORD
# SCHOOLB_STUDENT_PASSWORD=SET_LOCAL_SCHOOLB_STUDENT_PASSWORD
# HIT_ADMIN_PASSWORD=SET_LOCAL_HIT_ADMIN_PASSWORD
# HIT_ADMIN_PIN=SET_LOCAL_HIT_ADMIN_PIN
# SUPER_ADMIN_PASSWORD=SET_LOCAL_SUPER_ADMIN_PASSWORD
#
# R2_ENABLED=false
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PRIVATE_BUCKET_NAME=srms-v2
# R2_PUBLIC_BUCKET_NAME=srms-public-storage
# R2_ENDPOINT=
# R2_PUBLIC_BASE_URL=
# PAYMENT_CREDENTIALS_ENCRYPTION_KEY=
#
# DEFAULT_TENANT_SLUG=
#
# NGINX_SCHOOL_UPSTREAM=sms-school:80
# NGINX_STUDENT_UPSTREAM=sms-student:8080
# NGINX_ADMIN_UPSTREAM=sms-admin:80
# NGINX_API_UPSTREAM=sms-api:5000
# NGINX_SCHOOL_STRIP_PREFIX=true

# -----------------------------------------------------------------------------
# PROFILE: PRODUCTION (production deployment, uses .env.production)
# Run with: ./start-all.sh -e production up
# Or set ENVIRONMENT=production in .env and run: ./start-all.sh up
# -----------------------------------------------------------------------------
# ROOT_DOMAIN=your-production-domain.com
# HTTP_PORT=80
# NODE_ENV=production
# LOG_LEVEL=warn
# MONGO_DEBUG=false
#
# ENVIRONMENT=production
#
# DB_TYPE=docker
# DB_HOST=
# DB_PORT=27017
# DB_NAME=school-system
# DB_USERNAME=srms_admin
# DB_PASSWORD=GENERATE_A_UNIQUE_DATABASE_PASSWORD
# DB_AUTH_SOURCE=admin
# DB_REPLICA_SET=rs0
#
# JWT_SECRET=GENERATE_A_SECURE_RANDOM_SECRET
# SEED_DEMO_DATA=false
# HANFIA_ADMIN_PASSWORD=GENERATE_A_UNIQUE_PASSWORD
# DEMO_STUDENT_PASSWORD=GENERATE_A_UNIQUE_PASSWORD
# SCHOOLB_ADMIN_PASSWORD=GENERATE_A_UNIQUE_PASSWORD
# SCHOOLB_STUDENT_PASSWORD=GENERATE_A_UNIQUE_PASSWORD
# HIT_ADMIN_PASSWORD=GENERATE_A_UNIQUE_PASSWORD
# HIT_ADMIN_PIN=GENERATE_A_UNIQUE_PIN
# SUPER_ADMIN_PASSWORD=GENERATE_A_UNIQUE_PASSWORD
#
# R2_ENABLED=false
# R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
# R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY
# R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_KEY
# R2_PRIVATE_BUCKET_NAME=srms-v2
# R2_PUBLIC_BUCKET_NAME=srms-public-storage
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://YOUR_PUBLIC_BUCKET.r2.dev
# PAYMENT_CREDENTIALS_ENCRYPTION_KEY=GENERATE_SECURE_KEY
#
# DEFAULT_TENANT_SLUG=
#
# NGINX_SCHOOL_UPSTREAM=sms-school:80
# NGINX_STUDENT_UPSTREAM=sms-student:8080
# NGINX_ADMIN_UPSTREAM=sms-admin:80
# NGINX_API_UPSTREAM=sms-api:5000
# NGINX_SCHOOL_STRIP_PREFIX=true