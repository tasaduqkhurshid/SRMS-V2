# Local school hostname suffix; set to your production root domain when deploying.
ROOT_DOMAIN=sms.local
HTTP_PORT=80
NODE_ENV=development
LOG_LEVEL=info
MONGO_DEBUG=false

# Select the MongoDB used by sms-api: docker or local. Change DB_TYPE only to switch modes.
# In local mode, API containers reach the host MongoDB through host.docker.internal;
# a host-run API uses 127.0.0.1. COMPOSE_PROFILES follows DB_TYPE automatically.
DB_TYPE=docker
COMPOSE_PROFILES=${DB_TYPE:-docker}
DB_HOST=
DB_PORT=27017
DB_NAME=school-system
DB_USERNAME=admin
DB_PASSWORD=password
DB_AUTH_SOURCE=admin

# Development-only defaults. Change both before deployment.
JWT_SECRET=replace-with-a-long-random-secret
SEED_DEMO_DATA=true
HANFIA_ADMIN_PASSWORD=hanfia-admin-local-only
DEMO_STUDENT_PASSWORD=student-local-only
SCHOOLB_ADMIN_PASSWORD=schoolb-admin-local-only
SCHOOLB_STUDENT_PASSWORD=schoolb-student-local-only
SUPER_ADMIN_PASSWORD=platform-admin-local-only

# Cloudflare R2 is optional. The app boots and branding falls back when disabled.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sms-storage
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# Default tenant slug used when the request hostname is not a known school hostname
# (e.g., when accessed via an ngrok URL). Set to a school slug like "hanfia" to
# serve that school's data through a public ngrok URL. Leave empty for local
# hostname-based routing only.
DEFAULT_TENANT_SLUG=
