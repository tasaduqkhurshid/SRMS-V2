# Local Nginx upstreams use Vite/Nodemon Compose service names and ports.
NGINX_SCHOOL_UPSTREAM=sms-school-local:5173
NGINX_STUDENT_UPSTREAM=sms-student-local:8080
NGINX_ADMIN_UPSTREAM=sms-admin-local:5173
NGINX_API_UPSTREAM=sms-api-local:5000
# Vite serves the school app under /admin/, so preserve that prefix.
NGINX_SCHOOL_STRIP_PREFIX=false
