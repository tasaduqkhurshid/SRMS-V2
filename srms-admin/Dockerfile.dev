FROM node:20-bookworm-slim

WORKDIR /app

# Install wget for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends wget && rm -rf /var/lib/apt/lists/*

# Configure npm for better network resilience
RUN npm config set fetch-retries 3 && \
    npm config set fetch-retry-factor 2 && \
    npm config set fetch-retry-mintimeout 10000 && \
    npm config set fetch-retry-maxtimeout 60000 && \
    npm config set registry https://registry.npmjs.org/

# Install dependencies - explicitly install rollup optional dependency for linux x64
COPY package*.json ./
RUN npm install --no-audit --no-fund --prefer-offline || \
    (sleep 5 && npm install --no-audit --no-fund)
RUN npm install @rollup/rollup-linux-x64-gnu --no-audit --no-fund || true

# Copy source code
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Run Vite dev server with HMR
CMD ["npm", "run", "dev"]